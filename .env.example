# ── Deployment configuration ────────────────────────────────────────────────
# The deployment of record below is also built into src/lib/genlayer/config.ts
# as the fallback, so these values can stay blank in production and everything
# still resolves to the live contract. Set ACCORD_CONTRACT only to override it.
# Read server-side at request time; never shipped to the browser bundle.
# No database is required: the GenLayer contract is the only state.

GENLAYER_NETWORK=studionet
GENLAYER_CHAIN=61999
ACCORD_CONTRACT=0xF6cbD783355B209b9B37bc977Fc7DC14C86a2a56

# Optional RPC override; defaults to https://studio.genlayer.com/api
GENLAYER_RPC_URL=

# ── Scripts (server-side only) ──────────────────────────────────────────────
# Account used by scripts/deploy.py and the integration suite.
ACCORD_DEPLOYER_KEY=
